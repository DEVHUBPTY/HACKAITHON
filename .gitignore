# Secrets
.env
local.env

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Generated data (never versioned; see specs E0-03 and C-07)
data/senales.duckdb
data/demo.duckdb
outputs/benchmark/*
# La medición real del LLM (latencia, tokens, costo) se versiona: sin ella un clon limpio no puede reproducir metricas.json (X38).
!outputs/benchmark/medicion_llm.json

# Crudos con redistribución restringida (D-72): RSS de TVN (trae descripciones) y GDELT (trae socialimage).
# Se regeneran con `python -m scripts.extraer` (ver data/README.md). Banco Mundial y USGS sí se versionan.
data/raw/rss_tvn/
data/raw/gdelt/

# OS / editor
.DS_Store
.idea/
.vscode/

# Model caches
.cache/
models/

# Local tooling
.claude/worktrees/
.atl/
outputs/errores.csv
outputs/reporte_calidad.json

# Filas válidas de la carga (E1-02, D-82): derivado y regenerable con `poetry run python -m src.carga`.
data/processed/validos/

# Muestra de exploración y archivos de trabajo (E0-09)
data/exploracion/
outputs/costo_llm.json

# E1-16: las revisiones humanas son datos de la sesión del equipo, no del repositorio
data/revision.duckdb
data/revision_demo.duckdb
data/revision.duckdb.wal
data/revision_demo.duckdb.wal
outputs/notion/
data/revision_demo.casos.csv
# Registro de rechazos del validador (E1-13): artefacto de ejecución; las tasas se resumen con `python -m src.validador --tasas`.
outputs/rechazos.jsonl
